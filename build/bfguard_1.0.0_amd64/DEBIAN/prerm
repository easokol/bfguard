#!/bin/sh
set -e

case "$1" in
    remove|deconfigure|upgrade|failed-upgrade)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop bfguard.service >/dev/null 2>&1 || true
            systemctl disable bfguard.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
