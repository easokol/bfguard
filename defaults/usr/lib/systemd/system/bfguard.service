[Unit]
Description=BruteForce Guard Service
After=network.target
 
[Service]
Type=simple
User=root
Group=root
LimitNOFILE=1024

Restart=on-failure
RestartSec=10

WorkingDirectory=/etc/bfguard/
ExecStart=/usr/local/bin/bfguard

# make sure log directory exists and owned by syslog
PermissionsStartOnly=true
SyslogIdentifier=bfguard
 
[Install]
WantedBy=multi-user.target
